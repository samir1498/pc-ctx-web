---
import HubLayout from '../layouts/HubLayout.astro'
import UsageExplorer from '../components/UsageExplorer.tsx'
import { loadHubUsage } from '../lib/usage-load'

// The main dashboard: token usage across every tool on the box, not tied to a project.
const usage = await loadHubUsage(Astro.locals.hub)
const days = new Set(usage.rows.map((r) => r.date)).size
---

<HubLayout title="Token usage" active="usage">
  <h1 class="font-display text-3xl font-bold tracking-tight">Token usage</h1>
  <p class="mt-1 max-w-3xl text-muted">
    Tokens per day for Claude Code in WSL and on Windows, the Claude desktop app and Cowork, opencode, Hermes and other clients of the model router.
    Counted on the box once a day; no prompt text leaves it, only session titles. Days run on Berlin time. Claude.ai chat keeps its usage on Anthropic's side, so it shows only in the plan limits below.
  </p>
  <p class="mt-2 max-w-3xl text-sm text-dim">
    API value is what the same tokens would cost at API list prices. Claude Code runs on a subscription, so it is a comparison, not a bill. Free models count as 0.
  </p>
  <div class="mt-8 min-h-96">
    {days > 0 ? <UsageExplorer client:only="react" rows={usage.rows} sessions={usage.sessions} plan={usage.plan} /> : <p class="text-muted">No usage files yet. The collector on the box writes them once a day.</p>}
  </div>
</HubLayout>
