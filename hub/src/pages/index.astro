---
import HubLayout from '../layouts/HubLayout.astro'
import DailyUsageChart from '../components/charts/DailyUsageChart.tsx'
import StatusBar from '../components/StatusBar.astro'
import Sparkline from '../components/Sparkline.astro'
import { USAGE, TOOL_LABEL } from '../mock/usage'
import { SECTIONS, PRIMARY, section } from '../mock/sections'
import { byModel, lastDays, previousDays, slotOf, sum, totalTokens } from '../lib/usage'
import { dayLabel, pct, tokens, usd } from '../lib/format'

const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const cur = lastDays(USAGE, 14)
const t = sum(cur)
const p = sum(previousDays(USAGE, 14))
const models = byModel(cur)
const maxModelTokens = Math.max(...models.map(totalTokens))
const docs = SECTIONS.reduce((s, x) => s + x.count, 0)
const fresh = SECTIONS.reduce((s, x) => s + x.newThisWeek, 0)
const plans = section('plans')
const recent = PRIMARY.flatMap((k) => section(k).items.slice(0, 2).map((i) => ({ ...i, section: section(k).label, key: k })))
  .sort((a, b) => b.date.localeCompare(a.date))
  .slice(0, 8)
const byTool = (['claude-code', 'opencode', 'hermes'] as const).map((k) => ({ k, ...sum(cur.filter((r) => r.tool === k)) }))
---

<HubLayout title="Dashboard" active="dashboard">
  <div class="eyebrow">ObserveOne</div>
  <div class="mt-1 flex flex-wrap items-end justify-between gap-3">
    <div>
      <h1 class="font-display text-3xl font-bold tracking-tight">Dashboard</h1>
      <p class="mt-1 text-muted"><span class="num text-fg">{docs}</span> documents across {SECTIONS.length} sections, <span class="num text-fg">{fresh}</span> new this week</p>
    </div>
  </div>

  <section class="mt-8 grid gap-4 xl:grid-cols-3">
    <div class="card p-5 xl:col-span-2">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
          <h2 class="font-display text-lg font-semibold">Token usage, last 14 days</h2>
          <p class="text-xs text-dim">API-equivalent cost at list prices. Claude Code runs on a subscription.</p>
        </div>
        <a href={`${base}/usage`} class="text-sm text-accent hover:underline">Open usage</a>
      </div>
      <div class="mt-5 flex flex-wrap gap-x-10 gap-y-3">
        <div>
          <div class="eyebrow">Cost</div>
          <div class="num mt-1 text-4xl font-medium">{usd(t.cost)}</div>
          <div class="mt-1 text-xs text-dim">{pct(t.cost / p.cost - 1)} vs the 14 days before</div>
        </div>
        <div>
          <div class="eyebrow">Tokens</div>
          <div class="num mt-1 text-4xl font-medium">{tokens(totalTokens(t))}</div>
          <div class="mt-1 text-xs text-dim">{tokens(t.input + t.output)} in and out, the rest cache</div>
        </div>
        <div class="flex gap-6">
          {
            byTool.map((x) => (
              <div>
                <div class="eyebrow">{TOOL_LABEL[x.k]}</div>
                <div class="num mt-1 text-lg">{x.cost === 0 ? <span class="text-dim">no price</span> : usd(x.cost)}</div>
                <div class="num text-xs text-dim">{x.calls.toLocaleString('en-US')} calls</div>
              </div>
            ))
          }
        </div>
      </div>
      <div class="mt-6">
        <DailyUsageChart client:load rows={cur} group="model" metric="cost" height={300} />
      </div>
    </div>

    <div class="card p-5">
      <h2 class="font-display text-lg font-semibold">By model</h2>
      <p class="text-xs text-dim">Bar shows tokens, figure shows cost</p>
      <ul class="mt-4 space-y-3.5">
        {
          models.map((m) => (
            <li>
              <div class="flex items-baseline justify-between gap-3 text-sm">
                <span class="flex min-w-0 items-center gap-2">
                  <span class="size-2.5 shrink-0 rounded-sm" style={{ background: `var(${slotOf('model', m.model)})` }} />
                  <span class="truncate">{m.model}</span>
                </span>
                <span class="num shrink-0">{m.provider === 'opencode-go' ? <span class="text-dim">free</span> : m.cost === 0 ? <span class="text-dim">no price</span> : usd(m.cost)}</span>
              </div>
              <div class="mt-1.5 h-1.5 rounded-full bg-hover">
                <div class="h-1.5 rounded-full" style={{ width: `${Math.max(1, (totalTokens(m) / maxModelTokens) * 100)}%`, background: `var(${slotOf('model', m.model)})` }} />
              </div>
              <div class="num mt-1 text-xs text-dim">{totalTokens(m) === 0 ? `${m.calls.toLocaleString('en-US')} calls, tokens not reported` : `${tokens(totalTokens(m))} tokens · ${TOOL_LABEL[m.tool]}`}</div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="mt-10">
    <h2 class="font-display text-lg font-semibold">Sections</h2>
    <div class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-2 xl:grid-cols-4">
      {
        PRIMARY.map((k) => {
          const s = section(k)
          return (
            <a href={`${base}/s/${k}`} class="card group block p-4 transition-colors hover:border-line">
              <div class="flex items-baseline justify-between">
                <span class="font-medium">{s.label}</span>
                <span class="text-xs text-dim">+{s.newThisWeek} this week</span>
              </div>
              <div class="num mt-2 text-3xl font-medium">{s.count}</div>
              <div class="mt-3">
                <Sparkline values={s.weekly} label={`${s.label}, documents added per week over 12 weeks`} />
              </div>
            </a>
          )
        })
      }
    </div>
  </section>

  <section class="mt-10 grid gap-4 lg:grid-cols-2">
    <div class="card p-5">
      <div class="flex items-baseline justify-between">
        <h2 class="font-display text-lg font-semibold">Plans by status</h2>
        <a href={`${base}/s/plans`} class="text-sm text-accent hover:underline">All plans</a>
      </div>
      <div class="mt-4"><StatusBar statuses={plans.statuses ?? []} /></div>
    </div>
    <div class="card p-5">
      <h2 class="font-display text-lg font-semibold">Recent activity</h2>
      <ol class="mt-3 divide-y divide-border">
        {
          recent.map((r) => (
            <li class="flex items-center justify-between gap-3 py-2 text-sm">
              <span class="min-w-0">
                <span class="mr-2 text-xs text-dim">{r.section}</span>
                <span class="truncate">{r.title}</span>
              </span>
              <span class="num shrink-0 text-xs text-dim">{dayLabel(r.date)}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</HubLayout>
