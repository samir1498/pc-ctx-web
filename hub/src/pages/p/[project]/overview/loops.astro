---
import HubLayout from '../../../../layouts/HubLayout.astro'
import Crumbs from '../../../../components/Crumbs.astro'
import LoopTable from '../../../../components/overview/LoopTable.astro'
import OverviewHead from '../../../../components/overview/OverviewHead.astro'
import StateChip from '../../../../components/overview/StateChip.astro'
import { notFound, pageCtx } from '../../../../lib/page'
import { loadOverview, overviewBase } from '../../../../lib/overview'
import { LOOP_STATES } from '../../../../lib/overview-types'

const ctx = await pageCtx(Astro)
if (!ctx) return notFound('project')
const { project, store } = ctx
const overview = await loadOverview(store)
if (!overview) return notFound('overview')
const rank = (s: string) => LOOP_STATES.findIndex((x) => x === s)
const by = (owner: string) => overview.loops.filter((l) => l.owner === owner).sort((a, b) => rank(a.state) - rank(b.state))
const count = (s: string) => overview.loops.filter((l) => l.state === s).length
---

<HubLayout title="Loops" active="overview" project={project}>
  <Crumbs slot="crumbs" items={[{ label: project.name, href: `/p/${project.id}` }, { label: 'Overview', href: overviewBase(project.id) }, { label: 'Loops' }]} />
  <OverviewHead title="Loops" sub="Everything that runs by itself or in a chat. Running first.">
    <div class="flex flex-wrap gap-3">
      {LOOP_STATES.map((s) => <span class="inline-flex items-center gap-1.5"><StateChip state={s} /><b class="num text-xs">{count(s)}</b></span>)}
    </div>
  </OverviewHead>
  <LoopTable title="Ours" loops={by('ours')} />
  <LoopTable title="The owner's" loops={by('owner')} />
  {overview.folded.map((f) => <p class="mb-2 text-sm text-dim">{f}</p>)}
</HubLayout>
