---
import { BookOpen } from 'lucide-react'
import HubLayout from '../../../../../layouts/HubLayout.astro'
import Crumbs from '../../../../../components/Crumbs.astro'
import OverviewHead from '../../../../../components/overview/OverviewHead.astro'
import { notFound, pageCtx } from '../../../../../lib/page'
import { loadOverview, overviewBase } from '../../../../../lib/overview'

const ctx = await pageCtx(Astro)
if (!ctx) return notFound('project')
const { project, store } = ctx
const overview = await loadOverview(store)
if (!overview) return notFound('overview')
const base = overviewBase(project.id)
---

<HubLayout title="Docs for us" active="overview" project={project}>
  <Crumbs slot="crumbs" items={[{ label: project.name, href: `/p/${project.id}` }, { label: 'Overview', href: base }, { label: 'Docs for us' }]} />
  <OverviewHead title="Docs for us" sub="How-to pages for the two of us. Moved here from Docs, Processes and the guides folder." />
  <div class="card divide-y divide-border">
    {
      overview.docs.map((d) => (
        <a href={`${base}/docs/${d.slug}`} class="flex items-center gap-4 px-5 py-4 hover:bg-hover">
          <BookOpen className="size-5 shrink-0 text-accent" />
          <div class="min-w-0 flex-1"><div class="font-medium">{d.title}</div><div class="text-sm text-muted">{d.note}</div></div>
          <span class="num hidden text-xs text-dim sm:block">{d.slug}</span>
        </a>
      ))
    }
  </div>
  <p class="mt-4 text-sm text-dim">Old addresses under Docs and Processes answer with a redirect to the page here.</p>
</HubLayout>
