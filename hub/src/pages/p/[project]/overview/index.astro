---
import HubLayout from '../../../../layouts/HubLayout.astro'
import Crumbs from '../../../../components/Crumbs.astro'
import Legend from '../../../../components/overview/Legend.astro'
import OverviewHead from '../../../../components/overview/OverviewHead.astro'
import Section from '../../../../components/overview/Section.astro'
import StateDot from '../../../../components/overview/StateDot.astro'
import Strip from '../../../../components/overview/Strip.astro'
import { notFound, pageCtx } from '../../../../lib/page'
import { lastLabel, loadOverview, overviewBase, sharedAxis } from '../../../../lib/overview'

const ctx = await pageCtx(Astro)
if (!ctx) return notFound('project')
const { project, store, say } = ctx
const overview = await loadOverview(store)
if (!overview) return notFound('overview')
const base = overviewBase(project.id)
const today = new Date().toISOString().slice(0, 10)
const axis = sharedAxis(overview.products.flatMap((p) => p.strip), today)
const running = overview.loops.filter((l) => l.state === 'running')
const others = (['scheduled', 'quiet', 'stale', 'paused'] as const).map((s) => `${overview.loops.filter((l) => l.state === s).length} ${s}`)
const GRID = 'lg:grid lg:grid-cols-[17rem_minmax(0,1fr)_4.5rem_5.5rem_3rem] lg:items-center lg:gap-x-6'
---

<HubLayout title="Overview" active="overview" project={project}>
  <Crumbs slot="crumbs" items={[{ label: project.name, href: `/p/${project.id}` }, { label: 'Overview' }]} />
  <OverviewHead title="Overview" sub={`Where the apps stand and what is running, for the two of us. Updated ${lastLabel(overview.generatedAt)}.`} />

  <Section title="Products">
    <Legend slot="right" />
    <div class:list={[GRID, 'eyebrow hidden pb-1 pt-3']}>
      <span>Product</span>
      <div class="relative mr-2 h-4">
        {axis.months.map((m) => <span class="absolute top-0" style={{ left: `${m.at}%` }}>{m.label}</span>)}
        <span class="absolute -right-2 top-0">today</span>
      </div>
      <span class="text-right">Latest</span><span class="text-right">Customers</span><span class="text-right">Dots</span>
    </div>
    <ul class="divide-y divide-border border-b border-border">
      {
        overview.products.map((p) => (
          <li class:list={[GRID, 'py-3']}>
            <div class="min-w-0">
              <a href={`${base}/${p.id}`} class="text-[15px] font-medium hover:text-accent">{p.name}</a>
              <div class="mt-0.5 text-[13px] leading-snug text-muted">{p.tagline}</div>
            </div>
            <div class="my-2 lg:my-0"><Strip dots={p.strip} at={axis.at} months={axis.months} /></div>
            <span class="num text-[13px] lg:text-right">{p.latest || <span class="text-dim">none</span>}</span>
            <span class:list={['num text-[13px] lg:text-right', !p.customers && 'text-dim']}>{p.customers} <span class="text-dim lg:hidden">customers</span></span>
            <span class="num text-[13px] lg:text-right">{p.dots} <span class="text-dim lg:hidden">dots</span></span>
          </li>
        ))
      }
    </ul>
    <p class="mt-2.5 text-[13px] text-dim">One tick is one dot: a version, a feature released, an install, a customer count or a week of contacts. Every product is drawn on the same dates.</p>
  </Section>

  <div class="mt-10 grid gap-x-12 gap-y-10 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)]">
    <Section title="Running now" n={running.length}>
      <StateDot slot="mark" state="running" />
      <a slot="right" href={`${base}/loops`} class="text-accent underline decoration-accent/30 underline-offset-[3px]">All {overview.loops.length} loops</a>
      <ul class="divide-y divide-border">
        {
          running.map((l) => (
            <li class="grid grid-cols-[minmax(0,1fr)_6rem] items-baseline gap-x-6 py-2.5">
              <a href={`${base}/loops#${l.id}`} class="min-w-0 hover:text-accent">
                <div class="truncate font-medium">{say(l.name)}</div>
                <div class="line-clamp-2 text-[13px] text-muted">{say(l.what)}</div>
              </a>
              <span class="num whitespace-nowrap text-right text-xs text-dim">{lastLabel(l.last)}</span>
            </li>
          ))
        }
      </ul>
      {running.length === 0 && <p class="py-3 text-[13px] text-dim">Nothing is running this minute.</p>}
      <p class="mt-2.5 border-t border-border pt-2.5 text-[13px] text-dim">Also {others.join(', ')}.</p>
    </Section>
    <Section title="Docs for us" n={overview.docs.length}>
      <a slot="right" href={`${base}/docs`} class="text-accent underline decoration-accent/30 underline-offset-[3px]">All docs</a>
      <ul class="divide-y divide-border">
        {
          overview.docs.map((d) => (
            <li>
              <a href={`${base}/docs/${d.slug}`} class="block py-2.5 hover:text-accent">
                <div class="truncate font-medium">{say(d.title)}</div>
                <div class="text-[13px] text-muted">{say(d.note)}</div>
              </a>
            </li>
          ))
        }
      </ul>
    </Section>
  </div>
</HubLayout>
