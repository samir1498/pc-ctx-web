---
import HubLayout from '../../../layouts/HubLayout.astro'
import Crumbs from '../../../components/Crumbs.astro'
import SearchBox from '../../../components/SearchBox.astro'
import Chip from '../../../components/overview/Chip.astro'
import { notFound, pageCtx } from '../../../lib/page'
import { searchHub } from '../../../lib/overview'

const ctx = await pageCtx(Astro)
if (!ctx) return notFound('project')
const { project, store, say } = ctx
const q = (Astro.url.searchParams.get('q') ?? '').slice(0, 100).trim()
const groups = q ? await searchHub(store, project.id, q, say) : []
const total = groups.reduce((n, g) => n + g.hits.length, 0)
const words = q.toLowerCase().split(/\s+/).filter(Boolean)
const escapeRe = (s: string) => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')
// Split a text around the search words: odd parts are the matches.
const parts = (text: string) => (words.length ? text.split(new RegExp(`(${words.map(escapeRe).join('|')})`, 'i')) : [text])
const isMatch = (part: string) => words.includes(part.toLowerCase())
---

<HubLayout title={q ? `Search: ${q}` : 'Search'} active="search" project={project}>
  <Crumbs slot="crumbs" items={[{ label: project.name, href: `/p/${project.id}` }, { label: 'Search' }]} />
  <SearchBox project={project.id} value={q} big />
  <p class="mb-6 mt-3 text-sm text-muted">
    {q ? `${total} result${total === 1 ? '' : 's'} in the Overview section and in the rest of the hub, by title and summary.` : 'Type a word to search the Overview section and the rest of the hub, by title and summary.'}
  </p>
  {
    groups.map((g) => (
      <section id={g.key} class="mb-6">
        <div class="mb-2 flex items-center gap-2"><h2 class="eyebrow">{g.title}</h2><span class="num text-xs text-dim">{g.hits.length}</span></div>
        <div class="card divide-y divide-border">
          {g.hits.map((h) => (
            <a href={h.href} class="flex items-start gap-3 px-4 py-3 hover:bg-hover">
              <div class="min-w-0 flex-1">
                <div class="text-sm font-medium text-accent">{parts(h.title).map((p) => (isMatch(p) ? <mark class="rounded bg-warn/20 px-0.5 text-fg">{p}</mark> : p))}</div>
                {h.summary && <div class="mt-0.5 text-sm text-muted">{parts(h.summary).map((p) => (isMatch(p) ? <mark class="rounded bg-warn/20 px-0.5 text-fg">{p}</mark> : p))}</div>}
              </div>
              {h.meta && <span class="num text-xs text-dim">{h.meta}</span>}
              <Chip tone={h.chip.startsWith('Overview') ? 'accent' : 'plain'}>{h.chip}</Chip>
            </a>
          ))}
        </div>
      </section>
    ))
  }
  {q && total === 0 && <p class="text-sm text-dim">Nothing matches "{q}". Titles and summaries only; try a shorter word.</p>}
</HubLayout>
