---
import HubLayout from '../layouts/HubLayout.astro'
import ThemeGallery from '../components/ThemeGallery.tsx'

const hub = Astro.locals.hub
const project = hub.project(Astro.url.searchParams.get('p') ?? '') ?? hub.projects[0]
if (!project) return new Response('No project is configured.', { status: 500 })
---

<HubLayout title="Themes" active="themes" project={project}>
  <h1 class="font-display text-3xl font-bold tracking-tight">Themes</h1>
  <p class="mt-1 max-w-2xl text-muted">
    Six themes plus System. Each is one set of colour, font and corner tokens; the choice is kept in this browser.
    Chart colours keep the same hues in every theme so a model keeps its colour, stepped for light or dark backgrounds.
  </p>
  <div class="mt-8">
    <ThemeGallery client:load />
  </div>
</HubLayout>
