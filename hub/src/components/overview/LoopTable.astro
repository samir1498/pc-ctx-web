---
import StateChip from './StateChip.astro'
import { lastLabel } from '../../lib/overview'
import type { Loop } from '../../lib/overview-types'
interface Props {
  loops: Loop[]
  title: string
}
const { loops, title } = Astro.props
---

<section class="mb-7">
  <div class="mb-2 flex items-center gap-2">
    <h2 class="eyebrow">{title}</h2>
    <span class="num text-xs text-dim">{loops.length}</span>
  </div>
  <div class="card divide-y divide-border overflow-hidden">
    <div class="hidden grid-cols-[14rem_1fr_6.5rem_6rem] gap-4 bg-rail px-4 py-2 font-mono text-[11px] uppercase text-dim md:grid"><span>Loop</span><span>What it does</span><span>State</span><span class="text-right">Last</span></div>
    {
      loops.map((l) => (
        <div id={l.id} class="grid items-center gap-x-4 gap-y-1 px-4 py-3 text-sm md:grid-cols-[14rem_1fr_6.5rem_6rem]">
          {l.link ? <a href={l.link} class="font-medium hover:text-accent">{l.name}</a> : <span class="font-medium">{l.name}</span>}
          <span class="text-muted">{l.what}</span>
          <span><StateChip state={l.state} /></span>
          <span class="num text-xs text-dim md:text-right">{lastLabel(l.last)}</span>
        </div>
      ))
    }
  </div>
</section>
