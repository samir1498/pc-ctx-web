---
import Dot from './Dot.astro'
import type { StripDot } from '../../lib/overview-types'
interface Props {
  dots: StripDot[]
  /** Where "today" sits at the right end, as YYYY-MM-DD. */
  today: string
  /** Each dot links to this page's #id when set. */
  href?: string
}
const { dots, today, href } = Astro.props
const t = (d: string) => Date.parse(d)
const first = dots.length ? t(dots[0]?.date ?? today) : t(today)
const span = Math.max(t(today) - first, 1)
const left = (d: string) => `${3 + ((t(d) - first) / span) * 94}%`
---

<div class="relative h-5">
  <div class="absolute inset-x-0 top-1/2 h-px bg-line"></div>
  {
    dots.map((d) => (
      <span class="absolute top-1/2 -translate-x-1/2 -translate-y-1/2" style={{ left: left(d.date) }}>
        {href ? <a href={`${href}#${d.id}`} tabindex="-1" aria-hidden="true"><Dot kind={d.kind} size="sm" /></a> : <Dot kind={d.kind} size="sm" />}
      </span>
    ))
  }
</div>
