---
import Chip from './Chip.astro'
import type { LoopState } from '../../lib/overview-types'
interface Props {
  state: LoopState
}
const { state } = Astro.props
const TONE = { running: 'good', scheduled: 'accent', quiet: 'dim', stale: 'warn', paused: 'plain', done: 'dim' } as const
---

<Chip tone={TONE[state]}>{state}</Chip>
