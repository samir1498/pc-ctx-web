---
interface Props {
  title: string
  sub?: string
}
const { title, sub } = Astro.props
---

<div class="mb-6 flex flex-wrap items-end justify-between gap-x-6 gap-y-2">
  <div>
    <h1 class="font-display text-3xl font-semibold tracking-tight">{title}</h1>
    {sub && <p class="mt-1 text-sm text-muted">{sub}</p>}
  </div>
  <slot />
</div>
