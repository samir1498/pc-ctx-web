---
interface Props {
  title: string
  sub?: string
}
const { title, sub } = Astro.props
---

<header class="mb-8 flex flex-wrap items-end justify-between gap-x-8 gap-y-2">
  <div class="min-w-0">
    <h1 class="font-display text-3xl font-semibold tracking-tight">{title}</h1>
    {sub && <p class="mt-1.5 text-[15px] text-muted">{sub}</p>}
  </div>
  <slot />
</header>
