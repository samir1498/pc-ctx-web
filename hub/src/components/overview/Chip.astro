---
interface Props {
  tone?: 'plain' | 'accent' | 'good' | 'warn' | 'bad' | 'dim'
  href?: string
  class?: string
}
const { tone = 'plain', href, class: extra } = Astro.props
const TONE = {
  plain: 'bg-hover text-muted',
  accent: 'bg-accent-soft text-accent',
  good: 'bg-good/10 text-good',
  warn: 'bg-warn/10 text-warn',
  bad: 'bg-bad/10 text-bad',
  dim: 'bg-rail text-dim border border-border',
}
const Tag = href ? 'a' : 'span'
---

<Tag href={href} class:list={['inline-flex items-center gap-1 whitespace-nowrap rounded-full px-2 py-0.5 text-xs font-medium', TONE[tone], extra]}><slot /></Tag>
