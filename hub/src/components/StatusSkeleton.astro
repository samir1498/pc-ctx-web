---
interface Props {
  title: string
}
const { title } = Astro.props
---

<div class="card p-5" aria-busy="true">
  <h2 class="font-display text-lg font-semibold">{title}</h2>
  <div class="mt-4 h-3 animate-pulse rounded-full bg-hover"></div>
  <div class="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-3">
    {Array.from({ length: 5 }, () => <div class="h-4 animate-pulse rounded bg-hover" />)}
  </div>
</div>
