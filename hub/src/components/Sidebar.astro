---
import { PRIMARY, SECONDARY, PROJECTS, section } from '../mock/sections'

interface Props {
  active: string
  mobile?: boolean
}
const { active, mobile = false } = Astro.props
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const link = (p: string) => `${base}${p}`

const top = [
  { href: '/', label: 'Dashboard', key: 'dashboard' },
  { href: '/usage', label: 'Usage', key: 'usage' },
]
const project = PROJECTS[0]!
---

<nav
  class:list={[
    'flex flex-col bg-rail text-sm',
    mobile ? 'max-h-[70dvh] overflow-y-auto' : 'hidden border-r border-border lg:flex lg:h-dvh lg:overflow-y-auto',
  ]}
  aria-label="Sections"
>
  <div class="flex items-center gap-2.5 px-5 pb-4 pt-5">
    <div class="grid size-8 place-items-center rounded-card bg-accent font-display font-bold text-accent-fg">c</div>
    <div>
      <div class="font-display font-semibold leading-tight">Context hub</div>
      <div class="text-xs text-dim">pc-ctx stores, read live</div>
    </div>
  </div>

  <ul class="space-y-0.5 px-3">
    {
      top.map((t) => (
        <li>
          <a
            href={link(t.href)}
            class:list={[
              'flex items-center rounded-lg px-3 py-1.5 transition-colors',
              active === t.key ? 'bg-accent-soft font-medium text-accent' : 'text-muted hover:bg-hover hover:text-fg',
            ]}
          >
            {t.label}
          </a>
        </li>
      ))
    }
  </ul>

  <div class="mt-6 px-5">
    <label class="eyebrow mb-1.5 block" for={`project-${mobile ? 'm' : 'd'}`}>Project</label>
    <select id={`project-${mobile ? 'm' : 'd'}`} class="w-full rounded-lg border border-border bg-panel px-2.5 py-1.5 text-fg">
      {PROJECTS.map((p) => <option selected={p.key === project.key}>{p.label}</option>)}
    </select>
  </div>

  <ul class="mt-3 space-y-0.5 px-3">
    {
      PRIMARY.map((k) => {
        const s = section(k)
        return (
          <li>
            <a
              href={link(`/s/${k}`)}
              class:list={[
                'flex items-center justify-between rounded-lg px-3 py-1.5 transition-colors',
                active === k ? 'bg-accent-soft font-medium text-accent' : 'text-muted hover:bg-hover hover:text-fg',
              ]}
            >
              <span>{s.label}</span>
              <span class="num text-xs text-dim">{s.count}</span>
            </a>
          </li>
        )
      })
    }
  </ul>

  <div class="eyebrow mt-5 px-5">More</div>
  <ul class="mt-1.5 space-y-0.5 px-3">
    {
      SECONDARY.map((k) => {
        const s = section(k)
        return (
          <li>
            <a
              href={link(`/s/${k}`)}
              class:list={[
                'flex items-center justify-between rounded-lg px-3 py-1.5 transition-colors',
                active === k ? 'bg-accent-soft font-medium text-accent' : 'text-muted hover:bg-hover hover:text-fg',
              ]}
            >
              <span>{s.label}</span>
              <span class="num text-xs text-dim">{s.count}</span>
            </a>
          </li>
        )
      })
    }
  </ul>

  <div class="mt-auto border-t border-border px-5 py-4 text-xs text-dim">
    <a href={link('/themes')} class:list={['block hover:text-fg', active === 'themes' && 'font-medium text-accent']}>Themes</a>
    <div class="mt-2 flex items-center gap-2">
      <span class="size-1.5 rounded-full bg-good"></span> synced 2 min ago
    </div>
  </div>
</nav>
