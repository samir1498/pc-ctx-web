---
import type { Project } from '../source/projects'
import type { SectionSummary } from '../lib/dashboard'
import { PRIMARY, SECONDARY, label } from '../lib/sections'
import type { OverviewNav } from '../lib/overview'
import PlainSelect from './PlainSelect.astro'

interface Props {
  project?: Project
  projects: Project[]
  summaries: SectionSummary[]
  active: string
  mobile?: boolean
  /** The Overview section is listed only when the generator's files exist. */
  overview?: OverviewNav | null
}
const { project, projects, summaries, active, mobile = false, overview = null } = Astro.props
const base = project ? `/p/${project.id}` : ''
const count = new Map(summaries.map((s) => [s.key, s.count]))
const primary = PRIMARY.filter((k) => (count.get(k) ?? 0) > 0)
const secondary = SECONDARY.filter((k) => (count.get(k) ?? 0) > 0)
const top = project ? [{ href: base, label: project.audience === 'plain' ? 'Home' : 'Dashboard', key: 'dashboard' }] : []
const row = (on: boolean) => ['flex items-center justify-between px-3 py-1.5 transition-colors', on ? 'font-semibold text-fg' : 'text-muted hover:text-fg']
// Overview is open while on any of its pages; its children sit on a guide line.
const inOverview = active === 'overview' || active.startsWith('overview/')
const child = (on: boolean) => ['-ml-0.5 flex h-[26px] items-center justify-between border-l-2 pl-4 pr-3 text-[12.5px] transition-colors', on ? 'border-accent font-medium text-accent' : 'border-transparent text-dim hover:text-fg']
const id = mobile ? 'project-m' : 'project-d'
---

<nav
  class:list={['flex flex-col bg-rail text-sm', mobile ? 'max-h-[70dvh] overflow-y-auto' : 'hidden border-r border-border lg:flex lg:h-dvh lg:overflow-y-auto']}
  aria-label="Sections"
>
  <a href={base || '/'} class="flex items-center gap-2.5 px-5 pb-4 pt-5">
    <span class="grid size-8 place-items-center rounded-card bg-accent font-display font-bold text-accent-fg">{(project?.name ?? "c").charAt(0).toLowerCase()}</span>
    <span>
      <span class="block font-display font-semibold leading-tight">Context hub</span>
      <span class="block text-xs text-dim">{project?.name ?? 'All projects'}</span>
    </span>
  </a>

  <ul class="px-3 pb-3">
    <li><a href="/" class:list={row(active === 'usage')}>Token usage</a></li>
  </ul>

  {
    project && projects.length > 1 && (
      <div class="px-5 pb-3">
        <label class="eyebrow mb-1.5 block" for={id}>
          Project
        </label>
        <PlainSelect id={id} switcher class="font-medium text-fg">
          {projects.map((p) => (
            <option value={`/p/${p.id}`} selected={p.id === project?.id}>
              {p.name}
            </option>
          ))}
        </PlainSelect>
      </div>
    )
  }

  <ul class="space-y-0.5 px-3">
    {top.map((t) => <li><a href={t.href} class:list={row(active === t.key)}>{t.label}</a></li>)}
  </ul>

  <ul class="mt-4 space-y-0.5 px-3">
    {
      overview && project && (
        <li>
          <a href={`${base}/overview`} class:list={['flex items-center gap-1.5 px-3 py-1.5 transition-colors', active === 'overview' ? 'font-semibold text-accent' : inOverview ? 'font-semibold text-fg' : 'text-muted hover:text-fg']}>
            <svg class:list={['-ml-1 size-3.5 shrink-0 text-dim transition-transform', inOverview && 'rotate-90']} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6"></path></svg>
            <span class="flex-1">Overview</span>
            {!inOverview && <span class="num text-xs text-dim">{overview.count}</span>}
          </a>
          {inOverview && (
            <ul class="mb-2 ml-[1.15rem] mt-0.5 border-l-2 border-line/80">
              {overview.children.map((c) => (
                <li>
                  <a href={`${base}/overview/${c.id}`} class:list={child(active === `overview/${c.id}`)}>
                    <span>{c.label}</span>
                    <span class="num text-[11px] text-dim/70">{c.n}</span>
                  </a>
                </li>
              ))}
            </ul>
          )}
        </li>
      )
    }
    {
      primary.map((k) => (
        <li>
          <a href={`${base}/${k}`} class:list={row(active === k)}>
            <span>{label(k)}</span>
            <span class="num text-xs text-dim">{count.get(k)}</span>
          </a>
        </li>
      ))
    }
  </ul>

  {
    secondary.length > 0 && (
      <>
        <div class="eyebrow mt-5 px-5">More</div>
        <ul class="mt-1.5 space-y-0.5 px-3">
          {secondary.map((k) => (
            <li>
              <a href={`${base}/${k}`} class:list={row(active === k)}>
                <span>{label(k)}</span>
                <span class="num text-xs text-dim">{count.get(k)}</span>
              </a>
            </li>
          ))}
        </ul>
      </>
    )
  }

  <div class="mt-auto border-t border-border px-5 py-4 text-xs text-dim">
    <a href={project ? `/themes?p=${project.id}` : '/themes'} class:list={['block hover:text-fg', active === 'themes' && 'font-medium text-accent']}>Themes</a>
  </div>
</nav>
