---
import type { StatusCount as Status } from '../lib/dashboard'

interface Props {
  statuses: Status[]
}
const { statuses } = Astro.props
const total = statuses.reduce((s, x) => s + x.count, 0) || 1
const bg: Record<Status['tone'], string> = {
  accent: 'bg-accent',
  good: 'bg-good',
  warn: 'bg-warn',
  bad: 'bg-bad',
  dim: 'bg-dim',
}
---

<div>
  <div class="flex h-3 gap-0.5 overflow-hidden rounded-full" role="img" aria-label={statuses.map((s) => `${s.label} ${s.count}`).join(', ')}>
    {statuses.filter((s) => s.count > 0).map((s) => <div class={bg[s.tone]} style={{ width: `${(s.count / total) * 100}%` }} title={`${s.label}: ${s.count}`} />)}
  </div>
  <ul class="mt-3 grid grid-cols-2 gap-x-4 gap-y-1.5 text-sm sm:grid-cols-3">
    {
      statuses.map((s) => (
        <li class="flex items-center justify-between gap-2">
          <span class="flex items-center gap-2 text-muted">
            <span class:list={['size-2 rounded-full', bg[s.tone]]} />
            {s.label}
          </span>
          <span class="num text-fg">{s.count}</span>
        </li>
      ))
    }
  </ul>
</div>
