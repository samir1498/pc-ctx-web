---
// Only on pages whose body has a mermaid fence; mermaid itself (~2 MB) loads on demand.
---

<script>
  const blocks = document.querySelectorAll<HTMLElement>('code.language-mermaid')
  if (blocks.length) {
    const targets: HTMLElement[] = []
    blocks.forEach((code) => {
      const div = document.createElement('div')
      div.className = 'mermaid'
      div.textContent = code.textContent ?? ''
      ;(code.closest('pre') ?? code).replaceWith(div)
      targets.push(div)
    })
    import('mermaid')
      .then(({ default: mermaid }) => {
        const dark = getComputedStyle(document.documentElement).colorScheme === 'dark'
        // 'sandbox' renders each diagram in its own sandboxed frame.
        mermaid.initialize({ startOnLoad: false, securityLevel: 'sandbox', theme: dark ? 'dark' : 'neutral' })
        return mermaid.run({ nodes: targets })
      })
      .catch(() => {
        // leave the source visible
      })
  }
</script>
