---
interface Props {
  project: string
}
const { project } = Astro.props
// The results page fills the box with the query it shows.
const value = Astro.url.pathname.endsWith('/search') ? (Astro.url.searchParams.get('q') ?? '').slice(0, 100) : ''
---

<form action={`/p/${project}/search`} method="get" role="search" class="hidden w-72 sm:block">
  <label class="flex h-[34px] items-center gap-3 border-b border-line px-1 text-sm focus-within:border-accent">
    <svg class="size-4 shrink-0 text-dim" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
    <span class="sr-only">Search the hub</span>
    <input name="q" value={value} data-hub-search placeholder="Search the hub" autocomplete="off" class="w-full min-w-0 bg-transparent outline-none placeholder:text-dim" />
    <span class="shrink-0 font-mono text-[11px] text-dim" aria-hidden="true">press /</span>
  </label>
</form>
