---
import '../styles/global.css'
import Sidebar from '../components/Sidebar.astro'
import ThemeSwitcher from '../components/ThemeSwitcher.tsx'
import { THEME_STORAGE_KEY } from '../lib/themes'
import type { Project } from '../source/projects'
import { summarizeAll } from '../lib/dashboard'

interface Props {
  title: string
  active: string
  /** Absent on pages that belong to no project, such as the token usage dashboard. */
  project?: Project
}
const { title, active, project } = Astro.props
const hub = Astro.locals.hub
const store = project ? await hub.store(project.id) : null
const summaries = store ? summarizeAll(await store.trees()) : []
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title} · {project?.name ?? 'Context hub'}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Newsreader:opsz,wght@6..72,500;6..72,600&family=Space+Grotesk:wght@500;600;700&display=swap"
    />
    <!-- Applies the stored theme before first paint, so there is no flash. -->
    <script is:inline define:vars={{ key: THEME_STORAGE_KEY }}>
      try {
        const t = localStorage.getItem(key)
        if (t && t !== 'system') document.documentElement.setAttribute('data-theme', t)
      } catch (e) {}
    </script>
  </head>
  <body class="min-h-dvh">
    <div class="lg:grid lg:h-dvh lg:grid-cols-[16rem_1fr]">
      <Sidebar project={project} projects={hub.projects} summaries={summaries} active={active} />
      <div class="flex min-w-0 flex-col lg:h-dvh lg:overflow-y-auto">
        <header class="sticky top-0 z-10 flex items-center justify-between gap-3 border-b border-border bg-page/85 px-4 py-3 backdrop-blur sm:px-8">
          <div class="flex min-w-0 items-center gap-3">
            <details class="relative lg:hidden">
              <summary class="cursor-pointer list-none rounded-card border border-border bg-panel px-3 py-1.5 text-sm">Menu</summary>
              <div class="absolute left-0 top-11 z-20 w-64 overflow-hidden rounded-card border border-border shadow-xl">
                <Sidebar project={project} projects={hub.projects} summaries={summaries} active={active} mobile />
              </div>
            </details>
            <slot name="crumbs" />
          </div>
          <ThemeSwitcher client:load />
        </header>
        <main class="mx-auto w-full max-w-7xl flex-1 px-4 py-8 sm:px-8">
          <slot />
        </main>
      </div>
    </div>
    <script>
      document.querySelectorAll<HTMLSelectElement>('[data-project-switch]').forEach((el) => el.addEventListener('change', () => (location.href = el.value)))
    </script>
  </body>
</html>
